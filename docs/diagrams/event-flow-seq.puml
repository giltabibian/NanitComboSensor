@startuml event-flow-seq
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequence {
  ParticipantBackgroundColor #FDFDFD
  ParticipantBorderColor #444444
  LifeLineBorderColor #888888
}

actor Userspace as US
participant "IIO core" as IIO
participant "envcombo driver" as DRV
participant "IRQ thread" as IRQ
participant "ENV-COMBO\ndevice (CONTINUOUS)" as HW

== Configuration ==
US -> IIO : write thresh_rising_value (high) /\nthresh_falling_value (low)
IIO -> DRV : write_event_value
DRV -> HW : ALS_TH_HIGH / ALS_TH_LOW\n(validated: low <= high, 0..65535)
US -> IIO : write thresh_either_en = 1
IIO -> DRV : write_event_config
DRV -> HW : PWR_MODE <- CONTINUOUS\n(INT_EN already set at probe)
US -> US : open /dev/iio:deviceN,\nioctl(IIO_GET_EVENT_FD_IOCTL),\npoll(event_fd)

== Crossing detected ==
HW -> HW : conversion leaves the [low, high]\nwindow (in-range -> out-of-range):\nALS_RDY=1, ALS_INT=1 (latched)
HW -> IRQ : INT pulse (falling edge)
activate IRQ
IRQ -> HW : read STATUS (clears + re-arms)
note right of IRQ : ALS_RDY is serviced from the\nsame read (completion / buffer\ntrigger if active)
opt ALS_INT set && events enabled
  IRQ -> IIO : iio_push_event(THRESH, EITHER)
  IIO --> US : POLLIN -> read iio_event_data
end
deactivate IRQ
note over US, HW
  The hardware reports only "a threshold was crossed", with no
  direction, so the event is delivered as IIO_EV_DIR_EITHER per the
  datasheet. Userspace reads in_illuminance_raw if it needs to know
  which side of the window the value is on. No further event fires
  until the value returns inside the window and crosses out again.
end note
@enduml
